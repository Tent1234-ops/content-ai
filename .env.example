APP_NAME=Content AI Backend
APP_VERSION=0.1.0
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRE_MINUTES=60
ADMIN_INVITE_CODE=replace-with-admin-code
YOUTUBE_API_KEY=
YOUTUBE_REGION=TH
GOOGLE_REGION=TH
TIKTOK_REGION=TH

# Local demo analysis defaults. These avoid long model downloads and keep upload jobs responsive.
ASR_LOCAL_FILES_ONLY=1
ANALYZE_MAX_AUDIO_SECONDS=90
ANALYZE_ENABLE_ML_KEYWORDS=0
ANALYZE_ENABLE_VISUAL=0
NLP_USE_PYTHAINLP=0

# Use mysql or sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=content_ai
DB_USER=root
DB_PASSWORD=1234

# Or use a full SQLAlchemy URL directly
# DATABASE_URL=mysql+pymysql://root:1234@127.0.0.1:3306/content_ai
